# Salin file ini menjadi .env lalu isi nilainya. Jangan commit file .env.

# PostgreSQL.
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/transhome?sslmode=disable&search_path=crm_schema

# Nomor WhatsApp toko (628 diikuti 7-11 digit, tanpa + atau spasi).
# Hanya diubah Tim Cyber/operator server; restart backend setelah perubahan.
# Kosong = tombol WhatsApp nonaktif. Tidak ada fallback ke nomor di database.
WHATSAPP_NUMBER=

# Mekari Qontak
QONTAK_BASE_URL=
QONTAK_API_TOKEN=

# Login Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT untuk sesi login
JWT_SECRET=ganti-dengan-string-acak-panjang
